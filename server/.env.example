PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas Cloud Connection String)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/civicresolve?retryWrites=true&w=majority

# Client Application URL (For CORS and password reset email links)
CLIENT_URL=http://localhost:5173

# Local File Uploads Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Authentication & JWT Security Secrets
JWT_SECRET=civicresolve_dev_jwt_super_secret_access_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=civicresolve_dev_jwt_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Email Dispatcher Configuration (Optional - for real inbox delivery)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM_NAME=CivicResolve Support
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Cloud Media Storage Configuration (Optional - for permanent cloud CDN uploads)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
